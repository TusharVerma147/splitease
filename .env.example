# Copy to .env to override the defaults used by docker-compose.yml.
# `docker compose up --build` also works with no .env at all.

# ── Server ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000
CORS_ORIGINS=http://localhost:3000

# ── MongoDB / Redis / RabbitMQ ──────────────────────────
# Hostnames below are the docker-compose service names. For local `npm run dev`
# use localhost instead (mongodb://localhost:27017/splitease, ...).
MONGO_URI=mongodb://mongo:27017/splitease
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ── JWT (access: 15 min, refresh: 7 days - fixed by the spec) ──
# Use long random strings (>= 32 chars) in any real deployment.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars

# ── Email (Mailpit: read mail at http://localhost:8025) ──
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@splitease.local

# ── Login rate limit: 5 tries per minute per email + IP ──
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=5

# ── Background work ─────────────────────────────────────
# Where CSV exports are written (shared volume in docker-compose)
EXPORT_DIR=/app/exports
# Threads per worker pool (debt simplification, CSV generation)
WORKER_POOL_SIZE=2

# ── Host ports published by docker-compose (change if they clash) ──
API_PORT=3000
MONGO_PORT=27017
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
